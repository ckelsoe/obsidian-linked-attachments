{
	"name": "linked-attachments",
	"version": "3.3.0",
	"description": "Offload large, cold files to your own S3-compatible bucket and keep a resolvable pointer note in your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings 0 && prettier --check \"**/*.ts\" && node scripts/check-submission.mjs && npm run typecheck:marketplace",
		"test": "jest",
		"typecheck:marketplace": "tsc --noEmit -p tsconfig.scan.json",
		"test:integration": "node --env-file-if-exists=.env node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
		"knip": "knip",
		"type-coverage": "type-coverage",
		"test:mutation": "stryker run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "husky"
	},
	"typeCoverage": {
		"atLeast": 99
	},
	"keywords": [],
	"author": "Charles Kelsoe (ckelsoe)",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/jest-runner": "^9.6.1",
		"@types/jest": "^30.0.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"fast-check": "^4.8.0",
		"globals": "^17.1.0",
		"husky": "^9.1.7",
		"jest": "^30.2.0",
		"jiti": "^2.6.1",
		"knip": "^6.32.0",
		"obsidian": "^1.13.0",
		"prettier": "^3.9.6",
		"ts-jest": "^29.4.6",
		"tslib": "^2.8.1",
		"type-coverage": "^2.30.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.1",
		"yaml": "^2.9.0"
	},
	"overrides": {
		"handlebars": "^4.7.9",
		"qs": "^6.15.2",
		"picomatch": "^2.3.2",
		"flatted": "^3.4.0",
		"brace-expansion@1": "^1.1.18",
		"brace-expansion@2": "^2.1.4",
		"js-yaml": "^4.3.1",
		"@babel/core": "^7.29.6"
	},
	"dependencies": {
		"@types/node": "^24.0.7"
	}
}
